# Copy to .env.local for local dev, and set in Vercel for production.

# Public origin for canonical URLs, sitemap, and Open Graph images.
# Production defaults to https://sacramentodentalmedicine.com so canonical URLs
# remain stable across Vercel deployment aliases. Override only for an alternate
# approved public origin.
NEXT_PUBLIC_SITE_URL=

# Turn on only after Web Analytics is enabled for the Vercel project. The
# client strips query strings, groups /schedule under /conversion, and excludes
# /privacy-practices before sending a page view.
VERCEL_WEB_ANALYTICS_ENABLED=

# Unused after the Jarvis booking cutover. The Formspree dashboard form is
# unchanged for rollback; revert the booking PR to restore site delivery.
# FORMSPREE_ENDPOINT=
# LEAD_WEBHOOK_URL=
