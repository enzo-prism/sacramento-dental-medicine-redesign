# Copy to .env.local for local dev, and set in Vercel for production.

# Public origin for canonical URLs, sitemap, and Open Graph images.
# On Vercel this defaults to VERCEL_PROJECT_PRODUCTION_URL (the .vercel.app
# alias until the custom domain is attached). Set this to
# https://sacramentodentalmedicine.com at cutover. Do not attach DNS from here.
NEXT_PUBLIC_SITE_URL=

# Appointment requests POST to Formspree (see src/app/actions.ts).
# Override only if you swap forms; the site default is https://formspree.io/f/xvkpdvyz
FORMSPREE_ENDPOINT=

# Optional extra delivery hop after Formspree succeeds (CRM, Slack, etc.).
LEAD_WEBHOOK_URL=
